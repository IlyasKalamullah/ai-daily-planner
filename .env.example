# ====== WAJIB ======

# String acak untuk mengenkripsi sesi login.
# Buat dengan: npx auth secret   (atau: openssl rand -base64 32)
AUTH_SECRET=

# Dari Google Cloud Console > APIs & Services > Credentials > OAuth client ID
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# API key AI (gratis) dari https://console.groq.com/keys
AI_API_KEY=

# ====== OPSIONAL ======

# Penyedia AI: "groq" (default) atau "gemini"
# Kalau "gemini", isi AI_API_KEY dengan key dari https://aistudio.google.com/apikey
AI_PROVIDER=groq

# Model AI. Default Groq: openai/gpt-oss-120b (bagus untuk tool calling)
# Alternatif Groq: llama-3.3-70b-versatile | Default Gemini: gemini-2.5-flash
AI_MODEL=

# Batas pertanyaan chat per pengguna per hari (default 30)
CHAT_DAILY_LIMIT=30

# Batasi siapa yang boleh login (pisahkan dengan koma). Kosongkan = semua akun Google boleh.
ALLOWED_EMAILS=

# Upstash Redis (gratis) agar batas chat tersimpan permanen. Kosongkan = batas disimpan di memori
# (cukup untuk mulai, tapi bisa ter-reset saat server Vercel restart).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email kontak yang ditampilkan di halaman Privacy Policy
NEXT_PUBLIC_CONTACT_EMAIL=
